# Comet EM - the workspace whose training runs are read via `uvx comet-mcp`.
# Leave unset to serve synthetic sample runs from data/sample_runs.json instead.
COMET_API_KEY=your_comet_api_key_here
COMET_WORKSPACE=your_workspace
# Self-hosted Comet EM only.
# COMET_URL_OVERRIDE=

# Opik - where the audit traces land. Leave both unset to run every command in DRY_RUN
# (no LLM call, no traces; the rule-based findings still print).
OPIK_API_KEY=your_opik_api_key_here
OPIK_WORKSPACE=your_workspace
OPIK_PROJECT_NAME=gpu-capacity-planning
# Self-hosted / on-prem Opik only; defaults to Opik Cloud if unset.
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api

# LLM via litellm. Default model: anthropic/claude-sonnet-5 (CI overrides with OPIK_EXAMPLES_MODEL).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPIK_EXAMPLES_MODEL=anthropic/claude-haiku-4-5

# Rightsizing thresholds (percent mean GPU utilization) and sweep cap.
# CAPACITY_LOW_UTIL_PCT=30
# CAPACITY_IDLE_UTIL_PCT=10
# CAPACITY_MAX_RUNS=50
# MFU target for runs that log an `mfu` metric (train_demo --peak-tflops).
# CAPACITY_LOW_MFU_PCT=20

# --- AWS training box (infra/ terraform + run_remote_training.sh) -------------------
# Only needed for the optional real-GPU test run. Terraform reads the TF_VAR_* values;
# nothing account-specific is hardcoded in the .tf files.
# AWS_PROFILE=your-aws-profile
# TF_VAR_region=us-east-1
# 4x T4 for a real multi-GPU DDP run (~$4/hr on-demand - destroy the box when done).
# TF_VAR_instance_type=g4dn.12xlarge
# Your own address as /32 - the security group refuses 0.0.0.0/0.
# TF_VAR_allowed_ssh_cidr=203.0.113.7/32
# TF_VAR_public_key_path=~/.ssh/id_ed25519.pub
