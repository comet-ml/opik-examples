# Secrets (required for anything beyond run.sh)
COMET_API_KEY=
OPIK_API_KEY=
ANTHROPIC_API_KEY=

# One workspace for both products (Comet EM and Opik)
COMET_WORKSPACE=
OPIK_WORKSPACE=
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api

# One project name on both sides: the Comet EM project and the Opik project
OPIK_PROJECT_NAME=roadwork-detection

# Models, in litellm provider/model form. Leave empty for the defaults in config.py.
OPIK_EXAMPLES_MODEL=
JUDGE_MODEL=
# Judge for the Opik online rule (runs inside Opik). opik-free-model needs no provider key.
OPIK_ONLINE_JUDGE_MODEL=opik-free-model

# Asset names. Leave empty for the defaults in config.py; set them to run side by side.
REGISTRY_MODEL=
DATASET_ARTIFACT=
OPIK_DATASET=
PROMPT_NAME=
QUEUE_NAME=

# Where the prepared ROADWork data lives. Leave empty for ./data.
DATA_DIR=

# Which detector the Opik side uses: production (registry status), a version like 1.0.0, or stock.
DETECTOR_VERSION=
