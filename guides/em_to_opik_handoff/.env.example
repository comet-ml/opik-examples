# Secrets (required)
COMET_API_KEY=
OPIK_API_KEY=
ANTHROPIC_API_KEY=

# Workspaces
COMET_WORKSPACE_NAME=
OPIK_WORKSPACE=

# Names (defaults shown; change to reuse the demo side by side)
COMET_PROJECT=roadwork-detector
REGISTRY_MODEL=roadwork-yolo11s
DATASET_ARTIFACT=roadwork-yolo
OPIK_PROJECT=roadwork-triage
OPIK_DATASET=roadwork-verdicts-v1
PROMPT_NAME=roadwork-verdict
QUEUE_NAME=roadwork-review

# Models
VERDICT_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_URL=https://api.anthropic.com
# Judge model for the optional Opik online rule (runs inside Opik, needs a provider there).
# opik-free-model needs no provider key.
ONLINE_JUDGE_MODEL=opik-free-model
